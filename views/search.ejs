<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= q %> - Google Películas</title>
    <link rel="stylesheet" href="/app.css">
</head>
<body class="results-page">
    <%- include("partials/header", { q: q }) %>

    <main class="results">

        <p class="results-count">
            Resultados para <strong>"<%= q %>"</strong>:
            <%= results.length %> película<%= results.length === 1 ? "" : "s" %>
        </p>


        <% results.forEach(function(r){ %>
            <article class="result">
                <h2>
                    <a href="/film/<%= encodeURIComponent(r.titulo) %>"><%= r.info.Title %></a>
                </h2>
                <p class="result-url">/film/<%= encodeURIComponent(r.titulo) %></p>
                <p class="result-meta">
                    <strong>Año:</strong> <%= r.info.Year %> ·
                    <strong>Género:</strong> <%= r.info.Genre %> ·
                    <strong>Valoración:</strong> <%= r.info.imdbRating %>/10
                </p>
                <p class="result-plot"><%= r.info.Plot %></p>

                <div class="gallery">
                    <% r.info.Images.forEach(function(img, i){ %>
                        <img src="<%= img %>" alt="Imagen <%= i + 1 %> de <%= r.info.Title %>" loading="lazy">
                    <% }) %>
                </div>
            </article>
        <% }) %>
    </main>
</body>
</html>
