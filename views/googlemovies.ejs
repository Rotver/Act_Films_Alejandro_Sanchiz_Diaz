<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Películas</title>
    <link rel="stylesheet" href="/app.css">
</head>
<body class="home-page">
    <main class="google-home">
        <img src="/img/googlelogo.png" alt="Google" class="logo-home">
        <form action="/search" method="GET" class="google-form">
            <input type="text" name="q" placeholder="Buscar películas..." autofocus autocomplete="off" required>
            <div class="google-buttons">
                <button type="submit">Buscar con Google</button>
                <a href="/search?q=a" class="lucky-button">Voy a tener suerte</a>
            </div>
        </form>

        <p class="home-hint">Busca entre <%= films ? Object.keys(films).length : 0 %> películas: Avatar, 300, I Am Legend...</p>
    </main>

    <footer class="home-footer">
        <span>Actividad Films - Node JS + Express + EJS</span>
    </footer>
</body>
</html>
